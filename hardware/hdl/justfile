# Project Settings
MODULE := "top"
V_SRC := "top.v"
CPP_SRC := "vga_sim.cpp"
EXE := "vga_sim"

# Library Flags
# We use pkg-config for Raylib to ensure paths are correct
RAYLIB_LDFLAGS := `pkg-config --libs raylib 2>/dev/null || echo "-lraylib"`
RAYLIB_CFLAGS  := `pkg-config --cflags raylib 2>/dev/null || echo ""`

# Default recipe
default: build

# We use --build so Verilator handles the C++ compilation internally.
# This structure is much more robust against argument order errors.
[linux]
build:
	verilator -Wall -cc --trace --exe --build \
		--top-module top \
		-Wno-fatal \
		{{RAYLIB_CFLAGS}} \
		-LDFLAGS "{{RAYLIB_LDFLAGS}}" \
		-o {{EXE}} \
		{{V_SRC}} {{CPP_SRC}}

# We use --build so Verilator handles the C++ compilation internally.
# This structure is much more robust against argument order errors.
[macos]
build:
	verilator -Wall -cc --trace --exe --build \
		--top-module top \
		-Wno-fatal \
		-CFLAGS {{RAYLIB_CFLAGS}} \
		-LDFLAGS "{{RAYLIB_LDFLAGS}}" \
		-o {{EXE}} \
		{{V_SRC}} {{CPP_SRC}}


# For bear: we must clean first so it sees the full build process
compile_commands: clean
	bear -- just build

run: build
	./obj_dir/{{EXE}}

clean:
	rm -rf obj_dir {{EXE}} compile_commands.json
